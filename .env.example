# Copy to .env and adjust, or export these directly in your shell/CI.
# application.yml reads these with sensible local-dev defaults, so none
# of this is strictly required to run against the docker-compose Postgres.

DB_URL=jdbc:postgresql://localhost:5432/harvestflow
DB_USERNAME=harvestflow
DB_PASSWORD=harvestflow

# Generate a real random string before any deployment beyond local dev.
JWT_SECRET=this-is-a-dev-only-secret-change-it-before-any-real-deployment-0123456789
JWT_EXPIRATION_MINUTES=720

PORT=4000

# Set to false to skip seeding demo users/master data/cases (e.g. in CI).
SEED_ENABLED=true
