# Install once on the server:
#   sudo cp deploy/harvestflow-backend.service /etc/systemd/system/
#   sudo sed -i "s#__USER__#$USER#g; s#__HOME__#$HOME#g" /etc/systemd/system/harvestflow-backend.service
#   sudo systemctl daemon-reload && sudo systemctl enable --now harvestflow-backend
[Unit]
Description=HarvestFlow backend (Spring Boot)
After=network.target postgresql.service

[Service]
User=__USER__
WorkingDirectory=__HOME__/Harvesting-backend
EnvironmentFile=__HOME__/harvestflow.env
Environment=SPRING_PROFILES_ACTIVE=prod
ExecStart=/bin/bash -c 'exec java -jar $(ls __HOME__/Harvesting-backend/target/harvestflow-backend-*.jar | grep -v plain | head -1)'
Restart=on-failure
RestartSec=5
StandardOutput=append:__HOME__/Harvesting-backend/app.log
StandardError=append:__HOME__/Harvesting-backend/app.log

[Install]
WantedBy=multi-user.target
