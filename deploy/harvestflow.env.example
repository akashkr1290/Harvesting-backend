# Copy to ~/harvestflow.env on the server:  cp deploy/harvestflow.env.example ~/harvestflow.env && chmod 600 ~/harvestflow.env
# Every value marked REQUIRED must be filled in; the prod profile refuses to start without it.

SPRING_PROFILES_ACTIVE=prod
PORT=4000

# Database
DB_URL=jdbc:postgresql://localhost:5432/harvestflow
DB_USERNAME=harvestflow
DB_PASSWORD=change-me

# REQUIRED: random secret, generate with: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRATION_MINUTES=720

# REQUIRED: your web app origin(s), comma separated, e.g. https://main.xxxx.amplifyapp.com
CORS_ALLOWED_ORIGINS=

# REQUIRED: encryption key for Aadhaar/bank numbers, generate with: openssl rand -base64 32
# Existing rows encrypted with the old built-in key are still readable.
HARVESTFLOW_AADHAAR_ENCRYPTION_KEY=

# Payments: mock = simulated UPI (no real money). external = not wired yet.
PAYMENT_PROVIDER=mock

# Demo data: keep false on a real server
SEED_ENABLED=false

# OTP: false on real servers. true only for a private demo (accepts 123456).
OTP_DEV_MODE=false

# SMS gateway (needed for real OTPs). See HttpSmsSender for placeholders.
SMS_PROVIDER=log
SMS_HTTP_URL=
SMS_HTTP_METHOD=GET
SMS_HTTP_BODY=
SMS_HTTP_AUTH_HEADER=
SMS_HTTP_AUTH_VALUE=

# Marketplace: orders up to this many kg skip the internal 11-stage workflow (0 = always use it)
MARKETPLACE_DIRECT_MAX_KG=0

# Image verification: heuristic (built in) or external (Python AI service)
IMAGE_VERIFICATION_PROVIDER=heuristic

# Python AI service (ai-service/). Leave AI_ENABLED=false until it is running.
AI_ENABLED=false
AI_BASE_URL=http://127.0.0.1:8000
AI_API_KEY=
