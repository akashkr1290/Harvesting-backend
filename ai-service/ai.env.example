# Copy to ~/harvestflow-ai.env on the server (next to ~/harvestflow.env) and chmod 600.
# Same value as AI_API_KEY in ~/harvestflow.env. Generate: openssl rand -hex 32
AI_API_KEY=

# Forecasting engine: auto (Prophet for 24+ months, else Holt-Winters/Holt) | prophet | holtwinters
FORECAST_ENGINE=auto

# Routing: leave empty for straight-line x ROAD_FACTOR, or point to an OSRM server for road km.
OSRM_URL=
ROAD_FACTOR=1.3
AVG_SPEED_KMPH=35
ROUTE_TIME_LIMIT_S=5

# Mandi prices: free key from https://data.gov.in (My Account > API key)
DATAGOV_API_KEY=
MANDI_CACHE_HOURS=6

# Photo checks
DUPLICATE_HAMMING_THRESHOLD=6
MAX_GPS_DISTANCE_KM=50
# Vision models need the image built with VISION=true.
CLIP_MODEL=openai/clip-vit-base-patch32
